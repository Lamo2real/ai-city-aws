<mxfile host="app.diagrams.net"><diagram id="aic" name="AI City architecture"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AI City (Ace) on AWS&lt;/b&gt; - prod, eu-north-1, one AWS account, all serverless&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Every resource tagged Project/App/Environment/Owner/ManagedBy/CostCenter/Component (+AgentRole). Anthropic models only, billed through Amazon Bedrock.&lt;/font&gt;" style="text;html=1;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="owner" value="Owner&lt;br&gt;(browser / phone,&lt;br&gt;voice or text)" style="shape=mxgraph.basic.rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="130" height="70" as="geometry"/></mxCell><mxCell id="g_edge" value="Edge and identity" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5EAFE;strokeColor=#8C4FFF;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="190" y="80" width="240" height="470" as="geometry"/></mxCell><mxCell id="cf" value="CloudFront + WAF&lt;br&gt;(WAF in us-east-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="225" y="115" width="170" height="56" as="geometry"/></mxCell><mxCell id="s3hud" value="S3: HUD static files&lt;br&gt;(React app)" style="shape=cylinder3;boundedLbl=1;size=8;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B48CC;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="225" y="195" width="170" height="56" as="geo