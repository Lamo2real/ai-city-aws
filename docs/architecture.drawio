ometry></mxCell><mxCell id="e94" value="Converse (all runtimes)" style="endArrow=classic;html=1;rounded=0;strokeColor=#01A88D;fontColor=#01A88D;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rA" target="br"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="170"/><mxPoint x="2330" y="170"/></Array></mxGeometry></mxCell><mxCell id="e95" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#696969;fontColor=#696969;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="rM" target="mem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e96" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#696969;fontColor=#696969;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="rW" target="cib"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e97" value="image" style="endArrow=classic;html=1;rounded=0;strokeColor=#696969;fontColor=#696969;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ecr" target="rA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2150" y="190"/><mxPoint x="1510" y="190"/></Array></mxGeometry></mxCell><mxCell id="e98" value="PutEvents (all agents)" style="endArrow=classic;html=1;rounded=0;strokeColor=#0050EF;fontColor=#0050EF;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rW" target="eb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="1000"/><mxPoint x="1070" y="1000"/></Array></mxGeometry></mxCell><mxCell id="e99" value="Read &amp; Write (all agents)" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rW" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="770"/><mxPoint x="1300" y="1080"/><mxPoint x="620" y="1080"/></Array></mxGeometry></mxCell><mxCell id="e100" value="broadcast" style="endArrow=classic;html=1;rounded=0;strokeColor=#0050EF;fontColor=#0050EF;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="eb" target="wsl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="1060"/></Array></mxGeometry></mxCell><mxCell id="e101" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eb" target="ledw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e102" value="Write" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ledw" target="ddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="1390"/></Array></mxGeometry></mxCell><mxCell id="e103" value="approval.requested" style="endArrow=classic;html=1;rounded=0;strokeColor=#0050EF;fontColor=#0050EF;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="eb" target="sfn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e104" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sfn" target="apl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e105" value="resume turn" style="endArrow=classic;html=1;rounded=0;strokeColor=#0050EF;fontColor=#0050EF;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="apl" target="sqs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1620" y="1390"/><mxPoint x="1620" y="1060"/><mxPoint x="1340" y="1060"/><mxPoint x="1340" y="345"/></Array></mxGeometry></mxCell><mxCell id="e106" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#0050EF;fontColor=#0050EF;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="eb" target="notif"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1085" y="1310"/><mxPoint x="1850" y="1310"/></Array></mxGeometry></mxCell><mxCell id="e107" value="Publish" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="notif" target="sns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e108" value="GetSecretValue" style="endArrow=classic;html=1;rounded=0;strokeColor=#696969;fontColor=#696969;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="sm" target="rW"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2240" y="1250"/><mxPoint x="2240" y="770"/></Array></mxGeometry></mxCell><mxCell id="e109" value="push to main" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gh" target="act"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e110" value="OIDC token" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="act" target="oidc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e111" value="AssumeRoleWithWebIdentity" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="oidc" target="role"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e112" value="terraform plan / apply" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="role" target="tfs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e113" value="docker push (arm64)" style="endArrow=classic;html=1;rounded=0;strokeColor=#696969;fontColor=#696969;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="act" target="ecr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="1620"/><mxPoint x="2220" y="1620"/><mxPoint x="2220" y="80"/></Array></mxGeometry></mxCell><mxCell id="t114" value="&lt;font style='font-size:31px'&gt;&lt;b&gt;AI City hierarchy&lt;/b&gt;&lt;/font&gt; &lt;b&gt;- AgentCore Runtimes&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2700" y="-60" width="900" height="50" as="geometry"/></mxCell><mxCell id="t115" value="Agents talk only through tools; nobody waits in a session. Every turn is gated by pause, the policy gate and, if the owner set one, a spend cap." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2700" y="-5" width="900" height="40" as="geometry"/></mxCell><mxCell id="t116" value="&lt;table style='font-size:12px;border-collapse:collapse' cellpadding='3'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Agent&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Runtime&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Tools&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ace&lt;/td&gt;&lt;td&gt;&lt;code&gt;aic_prod_ace&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Sonnet 5.5&lt;/td&gt;&lt;td&gt;delegate_to_orchestrator, get_status, answer_question, instruct_agent, notes, reminders, pause_city, resume_city&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Orchestrator&lt;/td&gt;&lt;td&gt;&lt;code&gt;aic_prod_orchestrator&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Fable 5.1 &amp;gt; Opus 5.5&lt;/td&gt;&lt;td&gt;create_department, assign_to_department, get_reports, sign_off, ask_owner, report_to_ace&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Manager&lt;/td&gt;&lt;td&gt;&lt;code&gt;aic_prod_manager&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Fable 5.1 &amp;gt; Opus 5.5&lt;/td&gt;&lt;td&gt;hire_worker, assign, answer_worker, review, release_worker, save_specialist, ask_owner, report_to_orchestrator&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Worker&lt;/td&gt;&lt;td&gt;&lt;code&gt;aic_prod_worker&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Opus 5.5&lt;/td&gt;&lt;td&gt;granted built-ins + ask_manager, report_to_manager&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Utility&lt;/td&gt;&lt;td&gt;(Lambda / runtime)&lt;/td&gt;&lt;td&gt;Haiku 5.5&lt;/td&gt;&lt;td&gt;wake word, titles, compaction (prompts &amp;lt; 100k tokens)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2700" y="40" width="900" height="230" as="geometry"/></mxCell><mxCell id="t117" value="&lt;font style='font-size:31px'&gt;&lt;b&gt;Ledger&lt;/b&gt;&lt;/font&gt; &lt;b&gt;- DynamoDB (single table)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2700" y="320" width="900" height="50" as="geometry"/></mxCell><mxCell id="t118" value="One table, one implementation over a &lt;code&gt;Table&lt;/code&gt; interface (memory + DynamoDB). Spend counters are atomic ADDs; owner approvals are separate items only the API writes." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2700" y="375" width="900" height="45" as="geometry"/></mxCell><mxCell id="t119" value="&lt;table style='font-size:12px;border-collapse:collapse' cellpadding='3'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Item&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;SK&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Index&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ticket&lt;/td&gt;&lt;td&gt;&lt;code&gt;TICKET#id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;META&lt;/code&gt;, &lt;code&gt;HIST#...&lt;/code&gt;&lt;/td&gt;&lt;td&gt;gsi1 &lt;code&gt;TICKET#&amp;lt;status&amp;gt;&lt;/code&gt;, gsi2 &lt;code&gt;DEPT#&amp;lt;key&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Agent (hire)&lt;/td&gt;&lt;td&gt;&lt;code&gt;AGENT#id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;META&lt;/code&gt;, &lt;code&gt;SPEC&lt;/code&gt;&lt;/td&gt;&lt;td&gt;gsi1 &lt;code&gt;AGENT#&amp;lt;state&amp;gt;&lt;/code&gt;, gsi2 &lt;code&gt;DEPT#&amp;lt;key&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Department&lt;/td&gt;&lt;td&gt;&lt;code&gt;DEPT#key&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;META&lt;/code&gt;&lt;/td&gt;&lt;td&gt;gsi1 &lt;code&gt;DEPT&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Question&lt;/td&gt;&lt;td&gt;&lt;code&gt;Q#id&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;META&lt;/code&gt;&lt;/td&gt;&lt;td&gt;gsi1 &lt;code&gt;Q#open|answered&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Approval&lt;/td&gt;&lt;td&gt;&lt;code&gt;APPROVAL#id&lt;/code&gt; / &lt;code&gt;APPROVED#&amp;lt;hash&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;META&lt;/code&gt; / id&lt;/td&gt;&lt;td&gt;gsi1 &lt;code&gt;APPROVAL#&amp;lt;status&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Turn (cost row)&lt;/td&gt;&lt;td&gt;&lt;code&gt;TURN#agent&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;&amp;lt;at&amp;gt;#...&lt;/code&gt;&lt;/td&gt;&lt;td&gt;gsi1 &lt;code&gt;TURNDAY#&amp;lt;day&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Spend counters&lt;/td&gt;&lt;td&gt;&lt;code&gt;SPEND#DAY#&amp;lt;date&amp;gt;&lt;/code&gt;, &lt;code&gt;SPEND#MONTH#&amp;lt;m&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;GLOBAL&lt;/code&gt;, &lt;code&gt;DEPT#&lt;/code&gt;, &lt;code&gt;ROLE#&lt;/code&gt;, &lt;code&gt;MODEL#&lt;/code&gt;&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Worker slots / rate&lt;/td&gt;&lt;td&gt;&lt;code&gt;SLOTS&lt;/code&gt; / &lt;code&gt;RATE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;GLOBAL&lt;/code&gt;, &lt;code&gt;DEPT#&lt;/code&gt; / second&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Work lease&lt;/td&gt;&lt;td&gt;&lt;code&gt;WORK#&amp;lt;message&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;META&lt;/code&gt;&lt;/td&gt;&lt;td&gt;gsi1 &lt;code&gt;WORK#started&lt;/code&gt; (crash sweep)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Settings + pause&lt;/td&gt;&lt;td&gt;&lt;code&gt;CONFIG&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;code&gt;city&lt;/code&gt;&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2700" y="425" width="900" height="340" as="geometry"/></mxCell><mxCell id="t120" value="&lt;font style='font-size:31px'&gt;&lt;b&gt;A REQUEST, END TO END&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2700" y="810" width="900" height="50" as="geometry"/></mxCell><mxCell id="t121" value="&lt;b&gt;1. The owner types or speaks.&lt;/b&gt; The HUD posts &lt;code&gt;/messages&lt;/code&gt; with the Cognito JWT; ApiFn queues a message for Ace.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. The dispatcher takes it:&lt;/b&gt; pause flag &amp;gt; spend caps (if set) &amp;gt; (workers) slots and session rate &amp;gt; work lease &amp;gt; &lt;code&gt;InvokeAgentRuntime&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Ace runs one gated turn&lt;/b&gt; in AgentCore on Sonnet 5.5 through Bedrock: caps again if set, back-off, cost row, &lt;code&gt;cost.update&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Every tool call passes the policy gate.&lt;/b&gt; Deny rules block cloud changes, force-push and credential reads; ask rules become an approval in Step Functions, bound to the exact action.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Hand-offs are messages, not waits.&lt;/b&gt; Ace &amp;gt; Orchestrator &amp;gt; Manager &amp;gt; Workers each get a queue message; the next turn starts when a report arrives.&lt;br&gt;&lt;br&gt;&lt;b&gt;6. Events fan out&lt;/b&gt; on EventBridge: WebSocket (City view, Ace's reply), ledger trace, SNS email.&lt;br&gt;&lt;br&gt;&lt;b&gt;7. The Orchestrator signs off&lt;/b&gt; PASS / FAIL before anything leaves the city; Ace tells the owner." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2700" y="865" width="900" height="420" as="geometry"/></mxCell><mxCell id="t122" value="&lt;font style='font-size:31px'&gt;&lt;b&gt;SPEND: NO LIMIT&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2700" y="1330" width="900" height="50" as="geometry"/></mxCell><mxCell id="t123" value="The owner chose &lt;b&gt;no spend limit&lt;/b&gt;. Caps are optional in Settings (empty = no limit) and, when set, are checked before every turn. AWS Budgets only emails (50/80/100 % of $10,000 + forecast). Pause or &lt;code&gt;city-off.sh&lt;/code&gt; stops new work by hand. Concurrency ceilings stay (100 / dept, 2,450 total, 20 new sessions/s): they protect AgentCore quotas, not spend. Costs in the HUD are estimates; the AWS bill is the truth." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2700" y="1385" width="900" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
