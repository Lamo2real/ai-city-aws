<mxfile host="Electron"><diagram name="AI City architecture" id="aic-arch"><mxGraphModel dx="3000" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;font style='font-size:34px'&gt;&lt;b&gt;AI CITY (ACE) ON AWS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;One owner, one AWS account, region eu-north-1, environment &lt;code&gt;prod&lt;/code&gt;. &lt;b&gt;Amazon Bedrock AgentCore is the main service&lt;/b&gt;: every agent is a Claude model running in an AgentCore Runtime, billed only through Amazon Bedrock. Everything around it is serverless. Code: Python 3.13 (backend), React (HUD), Terraform (infra).&lt;br&gt;&lt;span style='color:#B20000'&gt;Red&lt;/span&gt; = owner calls authorized by Cognito. &lt;span style='color:#0050EF'&gt;Blue dashed&lt;/span&gt; = events and asynchronous hand-offs. Black = synchronous calls." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="-230" width="1800" height="120" as="geometry"/></mxCell><mxCell id="owner" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="-230" y="560" width="60" height="60" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Owner (you)&lt;/b&gt;&lt;br&gt;browser or phone; types or says&lt;br&gt;&quot;yo Ace ...&quot;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-290" y="630" width="180" height="60" as="geometry"/></mxCell><mxCell id="b3" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#0050EF;" vertex="1" parent="1"><mxGeometry x="-60" y="-60" width="2620" height="1560" as="geometry"/></mxCell><mxCell id="t4" value="AWS account - prod (eu-north-1) - every resource tagged Project / App / Environment / Owner / ManagedBy / CostCenter / Component (+ AgentRole)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;fontStyle=1;fontColor=#0050EF;" vertex="1" parent="1"><mxGeometry x="-35" y="-48" width="2570" height="26" as="geometry"/></mxCell><mxCell id="s3hud" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="60" height="60" as="geometry"/></mxCell><mxCell id="t5" value="aic-prod-hud" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-10" y="38" width="200" height="20" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b&gt;HUD static files&lt;/b&gt;&lt;br&gt;React 19 app (Ace, City view, Needs you, Tickets, Costs, Settings). Private bucket, read only by CloudFront (OAC)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="132" y="58" width="230" height="90" as="geometry"/></mxCell><mxCell id="cf" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="60" height="60" as="geometry"/></mxCell><mxCell id="t7" value="HUD CloudFront" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-10" y="278" width="200" height="20" as="geometry"/></mxCell><mxCell id="t8" value="&lt;b&gt;CDN + HTTPS&lt;/b&gt;&lt;br&gt;security headers, SPA fallback" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="132" y="298" width="150" height="90" as="geometry"/></mxCell><mxCell id="waf" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="50" height="50" as="geometry"/></mxCell><mxCell id="t9" value="WAF (us-east-1)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="278" width="190" height="20" as="geometry"/></mxCell><mxCell id="cog" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="60" height="60" as="geometry"/></mxCell><mxCell id="t10" value="Owner user pool" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-10" y="518" width="200" height="20" as="geometry"/></mxCell><mxCell id="t11" value="&lt;b&gt;Cognito&lt;/b&gt;&lt;br&gt;MFA (TOTP) required, admin-create only, group &lt;code&gt;owner&lt;/code&gt;, PKCE managed login" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="132" y="538" width="230" height="90" as="geometry"/></mxCell><mxCell id="idp" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="60" height="60" as="geometry"/></mxCell><mxCell id="t12" value="Identity pool" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-10" y="768" width="200" height="20" as="geometry"/></mxCell><mxCell id="t13" value="&lt;b&gt;Speech credentials&lt;/b&gt;&lt;br&gt;owner-only role: Transcribe streaming + Polly" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="132" y="788" width="200" height="90" as="geometry"/></mxCell><mxCell id="tr" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transcribe;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="50" height="50" as="geometry"/></mxCell><mxCell id="t14" value="Transcribe" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-30" y="978" width="190" height="20" as="geometry"/></mxCell><mxCell id="po" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.polly;" vertex="1" parent="1"><mxGeometry x="160" y="1000" width="50" height="50" as="geometry"/></mxCell><mxCell id="t15" value="Polly" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="978" width="190" height="20" as="geometry"/></mxCell><mxCell id="http" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="60" height="60" as="geometry"/></mxCell><mxCell id="t16" value="aic-prod-http" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="278" width="200" height="20" as="geometry"/></mxCell><mxCell id="t17" value="&lt;b&gt;HTTP API&lt;/b&gt;&lt;br&gt;JWT authorizer (owner group)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="632" y="298" width="170" height="90" as="geometry"/></mxCell><mxCell id="apil" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="60" height="60" as="geometry"/></mxCell><mxCell id="t18" value="ApiFn" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="278" width="200" height="20" as="geometry"/></mxCell><mxCell id="wsapi" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="560" y="540" width="60" height="60" as="geometry"/></mxCell><mxCell id="t19" value="aic-prod-ws" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="518" width="200" height="20" as="geometry"/></mxCell><mxCell id="t20" value="&lt;b&gt;WebSocket API&lt;/b&gt;&lt;br&gt;Lambda authorizer (Cognito JWT)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="632" y="538" width="170" height="90" as="geometry"/></mxCell><mxCell id="wsl" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="800" y="540" width="60" height="60" as="geometry"/></mxCell><mxCell id="t21" value="WsConnect / WsBroadcastFn" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="518" width="200" height="20" as="geometry"/></mxCell><mxCell id="sqs" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="60" height="60" as="geometry"/></mxCell><mxCell id="t22" value="aic-prod-* queues" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="278" width="200" height="20" as="geometry"/></mxCell><mxCell id="t23" value="&lt;b&gt;4 work queues + DLQs&lt;/b&gt;&lt;br&gt;one message = one agent turn" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1112" y="298" width="170" height="90" as="geometry"/></mxCell><mxCell id="disp" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="60" height="60" as="geometry"/></mxCell><mxCell id="t24" value="DispatcherFn" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="538" width="200" height="20" as="geometry"/></mxCell><mxCell id="t25" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;1 pause flag&lt;br&gt;2 spend caps (only if set; none by default)&lt;br&gt;3 worker slots (100 / dept, 2,450 total)&lt;br&gt;4 new-session rate (20/s)&lt;br&gt;5 work lease (idempotent)&lt;br&gt;6 InvokeAgentRuntime" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="628" width="230" height="130" as="geometry"/></mxCell><mxCell id="fac" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1040" y="840" width="60" height="60" as="geometry"/></mxCell><mxCell id="t26" value="AgentFactoryFn" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="818" width="200" height="20" as="geometry"/></mxCell><mxCell id="t27" value="&lt;b&gt;Agent Factory&lt;/b&gt;&lt;br&gt;hire / retire workers; builds the worker spec from a department template" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1112" y="838" width="200" height="90" as="geometry"/></mxCell><mxCell id="g28" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A1A1A1;" vertex="1" parent="1"><mxGeometry x="1400" y="80" width="760" height="820" as="geometry"/></mxCell><mxCell id="t29" value="&lt;b&gt;Amazon Bedrock AgentCore&lt;/b&gt; - main service. 4 Runtimes (ARM64 Python containers, /ping + /invocations, Claude Agent SDK for Python). Departments and workers are sessions, never new runtimes." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=12;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="1420" y="92" width="600" height="50" as="geometry"/></mxCell><mxCell id="ecr" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,