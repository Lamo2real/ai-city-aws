<mxfile host="drawio"><diagram id="aic" name="AI City on AWS"><mxGraphModel dx="4000" dy="3000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="&lt;b&gt;Synced with the ai-city-aws repo, branch &lt;code&gt;main&lt;/code&gt; (9 Nov 2026, HEAD &lt;code&gt;80a08f5&lt;/code&gt;), one AWS account (552687213402), one environment (&lt;code&gt;prod&lt;/code&gt;), Terraform in &lt;code&gt;infra/&lt;/code&gt;.&lt;/b&gt;&lt;br&gt;16 Lambdas (Python 3.13, arm64, JSON logs, X-Ray) &amp;#183; 5 AgentCore runtimes (AIC, Orchestrator, Manager, Worker, MCP host) &amp;#183; 3 DynamoDB tables (PITR + KMS) &amp;#183; 7 S3 buckets &amp;#183; 4 work queues + DLQs &amp;#183; 2 Step Functions &amp;#183; 9 EventBridge schedules &amp;#183; 2 CloudFront distributions &amp;#183; 1 Cognito user pool + 1 identity pool &amp;#183; HTTP API + WebSocket API &amp;#183; every push to &lt;code&gt;main&lt;/code&gt; deploys through GitHub OIDC" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="-70" width="2600" height="54" as="geometry"/></mxCell><mxCell id="a2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;arcSize=2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3300" height="1250" as="geometry"/></mxCell><mxCell id="a3" value="AI City core - the owner talks to AIC; work flows down the hierarchy and comes back as live events" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontStyle=1;fontColor=#0050EF;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="3260" height="34" as="geometry"/></mxCell><mxCell id="owner" value="Owner (you, &amp;quot;Sir&amp;quot;)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradien