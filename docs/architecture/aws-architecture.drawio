AIC" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1828" y="2288" width="380" height="56" as="geometry"/></mxCell><mxCell id="v_polly" value=" " style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.polly;fillColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="1760" y="2410" width="56" height="56" as="geometry"/></mxCell><mxCell id="a154" value="Polly (eu-central-1)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1828" y="2406" width="380" height="22" as="geometry"/></mxCell><mxCell id="a155" value="standard voice when OpenAI TTS is off" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1828" y="2428" width="380" height="56" as="geometry"/></mxCell><mxCell id="v_sonic" value=" " style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.machine_learning;fillColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="2460" y="2270" width="56" height="56" as="geometry"/></mxCell><mxCell id="a156" value="Nova 2.5 Sonic through the AIC runtime" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2528" y="2266" width="380" height="22" as="geometry"/></mxCell><mxCell id="a157" value="POST /voice/session → signed WSS to the runtime's /ws → Bedrock bidirectional stream" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2528" y="2288" width="380" height="56" as="geometry"/></mxCell><mxCell id="a158" value="open call" style="endArrow=classic;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="v_api" target="v_openai"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a159" value="Audio goes straight between the browser and OpenAI (WebRTC). Every request is AIC's: GPT-Live hands it over, AIC answers in the chat and GPT-Live says the answer." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2460" y="2420" width="780" height="60" as="geometry"/></mxCell><mxCell id="a160" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;arcSize=2;" vertex="1" parent="1"><mxGeometry x="0" y="2620" width="3300" height="560" as="geometry"/></mxCell><mxCell id="a161" value="Security, cost and CI/CD - GitHub OIDC (no long-lived AWS keys); one account, one environment" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontStyle=1;fontColor=#0050EF;" vertex="1" parent="1"><mxGeometry x="20" y="2625" width="3260" height="34" as="geometry"/></mxCell><mxCell id="kms" value=" " style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="60" y="2720" width="64" height="64" as="geometry"/></mxCell><mxCell id="a162" value="KMS customer key" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="136" y="2716" width="290" height="22" as="geometry"/></mxCell><mxCell id="a163" value="DynamoDB, SQS, logs, Lambda env, buckets" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="136" y="2738" width="290" height="64" as="geometry"/></mxCell><mxCell id="sm" value=" " style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="60" y="2850" width="64" height="64" as="geometry"/></mxCell><mxCell id="a164" value="Secrets Manager" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="136" y="2846" width="290" height="22" as="geometry"/></mxCell><mxCell id="a165" value="aic/prod/openai · github · apns · oauth-google / microsoft · connectors/* · mail/*" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="136" y="2868" width="290" height="64" as="geometry"/></mxCell><mxCell id="iam" value=" " style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="60" y="2980" width="64" height="64" as="geometry"/></mxCell><mxCell id="a166" value="IAM roles + permissions boundary" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="136" y="2976" width="290" height="22" as="geometry"/></mxCell><mxCell id="a167" value="one role per agent role and per Lambda; agents can never change infra, IAM or the policy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="136" y="2998" width="290" height="64" as="geometry"/></mxCell><mxCell id="cw" value=" " style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="560" y="2720" width="64" height="64" as="geometry"/></mxCell><mxCell id="a168" value="CloudWatch" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="636" y="2716" width="290" height="22" as="geometry"/></mxCell><mxCell id="a169" value="JSON logs, dashboard, alarms; X-Ray tracing" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="636" y="2738" width="290" height="64" as="geometry"/></mxCell><mxCell id="budget" value=" " style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="560" y="2850" width="64" height="64" as="geometry"/></mxCell><mxCell id="a170" value="AWS Budgets" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="636" y="2846" width="290" height="22" as="geometry"/></mxCell><mxCell id="a171" value="e-mail only; the owner's own spend caps are checked before every turn" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="636" y="2868" width="290" height="64" as="geometry"/></mxCell><mxCell id="deploy" value=" " style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="560" y="2980" width="64" height="64" as="geometry"/></mxCell><mxCell id="a172" value="Deploy role (GitHub OIDC)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="636" y="2976" width="290" height="22" as="geometry"/></mxCell><mxCell id="a173" value="accepts only main / production of Lamo2real/ai-city-aws" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="636" y="2998" width="290" height="64" as="geometry"/></mxCell><mxCell id="gh_actions" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;deploy.yml on every push to main: backend · web · plan · apply · frontend&lt;br&gt;ios-testflight.yml: iPhone app → TestFlight" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="2720" width="420" height="80" as="geometry"/></mxCell><mxCell id="a174" value="AssumeRoleWithWebIdentity" style="endArrow=classic;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="gh_actions" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a175" value="&lt;b&gt;How a release works&lt;/b&gt;&lt;br&gt;1. A push to &lt;code&gt;main&lt;/code&gt; runs the tests (pytest, ruff, mypy, vitest, Playwright, Terraform tests).&lt;br&gt;2. The backend is zipped for the Lambdas and built into one arm64 image for the AgentCore runtimes (ECR, immutable tags).&lt;br&gt;3. &lt;code&gt;terraform plan&lt;/code&gt;, then &lt;code&gt;apply&lt;/code&gt; (no approval step: the owner's choice); Lambdas publish a new version and the &lt;code&gt;live&lt;/code&gt; alias moves to it.&lt;br&gt;4. The HUD is built and synced to the HUD bucket; CloudFront is invalidated.&lt;br&gt;5. Docs-only pushes and &lt;code&gt;[skip ci]&lt;/code&gt; do not deploy." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="2830" width="1100" height="130" as="geometry"/></mxCell><mxCell id="a176" value="HOW A REQUEST FLOWS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=28;" vertex="1" parent="1"><mxGeometry x="3450" y="0" width="700" height="80" as="geometry"/></mxCell><mxCell id="a177" value="&lt;b&gt;1. The owner talks or types to AIC&lt;/b&gt; in the HUD or the iPhone app, signed in with the Cognito owner pool (MFA)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="100" width="700" height="60" as="geometry"/></mxCell><mxCell id="a178" value="&lt;b&gt;2. The api Lambda records the message&lt;/b&gt; in the ledger and puts it on the &lt;code&gt;ace&lt;/code&gt; queue." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="170" width="700" height="60" as="geometry"/></mxCell><mxCell id="a179" value="&lt;b&gt;3. The dispatcher invokes AIC's runtime.&lt;/b&gt; AIC (Haiku 5.5) answers simple things itself, or delegates." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="240" width="700" height="60" as="geometry"/></mxCell><mxCell id="a180" value="&lt;b&gt;4. The Orchestrator (Fable 5.2) plans&lt;/b&gt; and sends each part to a department's manager through its queue." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="310" width="700" height="60" as="geometry"/></mxCell><mxCell id="a181" value="&lt;b&gt;5. The manager (Fable 5.2) hires workers&lt;/b&gt; (factory Lambda), exactly as many as the owner asked for." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="380" width="700" height="60" as="geometry"/></mxCell><mxCell id="a182" value="&lt;b&gt;6. Workers do the job&lt;/b&gt; with their granted tools and connectors; every tool call passes the policy gate." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="450" width="700" height="60" as="geometry"/></mxCell><mxCell id="a183" value="&lt;b&gt;7. The manager reviews every deliverable&lt;/b&gt; (PASS / FAIL) and reports up; AIC tells the owner." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="520" width="700" height="60" as="geometry"/></mxCell><mxCell id="a184" value="&lt;b&gt;8. Every step is an event&lt;/b&gt; on the city bus: the ledger-writer stores it and ws-broadcast shows it live." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="590" width="700" height="60" as="geometry"/></mxCell><mxCell id="a185" value="&lt;b&gt;9. While the owner is away,&lt;/b&gt; Autopilot's Chief of Staff decides questions and approvals, standing orders run the support desk and sales follow-ups, and the 17:00 digest says what happened." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3450" y="660" width="700" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>