=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="860" y="950" width="64" height="64" as="geometry"/></mxCell><mxCell id="deploy" value="IAM deploy role&lt;br&gt;(GitHub OIDC)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;fillColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="1100" y="950" width="64" height="64" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch&lt;br&gt;logs · dashboard · alarms" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1340" y="950" width="64" height="64" as="geometry"/></mxCell><mxCell id="budgets" value="AWS Budgets&lt;br&gt;(e-mail only)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1580" y="950" width="64" height="64" as="geometry"/></mxCell><mxCell id="transcribe" value="Transcribe streaming&lt;br&gt;+ vocabulary (Ace → AIC)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transcribe;fillColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="2400" y="170" width="64" height="64" as="geometry"/></mxCell><mxCell id="polly" value="Polly&lt;br&gt;(standard voice)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.polly;fillColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="2400" y="330" width="64" height="64" as="geometry"/></mxCell><mxCell id="s3_speech" value="S3&lt;br&gt;vocabulary table" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="2400" y="490" width="64" height="64" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;How a request flows&lt;/b&gt;&lt;br&gt;1. The owner signs in (Cognito, MFA) and talks or types to AIC in the HUD or the iPhone app.&lt;br&gt;2. The API Lambda records the message and queues it (SQS); the dispatcher invokes AgentCore Runtime.&lt;br&gt;3. AIC (Haiku) answers or delegates: Orchestrator → Department Managers → Workers, each a turn on Bedrock.&lt;br&gt;4. Every tool call passes the policy gate; connectors go through AgentCore Gateway with OAuth or Secrets Manager keys.&lt;br&gt;5. Agents emit events on EventBridge; the ledger-writer stores them in DynamoDB and ws-broadcast pushes them live to the HUD.&lt;br&gt;6. Schedules (standing orders, Autopilot's Chief of Staff, mail imports) run from EventBridge rules.&lt;br&gt;7. Voice: GPT-Live over WebRTC straight from the browser to OpenAI (the API opens the call; the key stays in Secrets Manager), Nova Sonic as backup; Transcribe and Polly in Frankfurt with Cognito identity-pool credentials.&lt;br&gt;8. Outside: connectors reach Slack, Jira, HubSpot, Canva, YouTube and more through AgentCore Gateway; workers use GitHub with the owner's token; pushes go to the iPhone through SNS and APNs; GitHub Actions deploys with Terraform through the OIDC deploy role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="300" y="1100" width="1960" height="170" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="owner" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="owner" target="iphone"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#147EBA;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="waf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#147EBA;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="waf" target="cf_hud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#147EBA;fontSize=10;fontCol