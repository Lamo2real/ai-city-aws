  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1163.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1163.0",
    "@aws-sdk/credential-providers": "^3.1163.0",
    "@fontsource/silkscreen": "^5.3.0",
    "aws-amplify": "^6.22.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6"
  }
