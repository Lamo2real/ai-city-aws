# Copy to prod.tfvars (git-ignored) and fill in. No secrets belong here.
owner_email        = "you@example.com"
region             = "eu-north-1"
monthly_budget_usd = 10000
agent_image_tag    = "set-by-deploy-workflow"
profile_prefix     = "global"
# Set to false if creating application inference profiles from global profiles is refused.
use_application_inference_profiles = true
deletion_protection                = true
# Mail and calendar OAuth clients (docs/RUNBOOK.md). Client ids only; the secrets go into Secrets Manager.
mail_providers = {
  google    = { enabled = false, client_id = "" }
  microsoft = { enabled = false, client_id = "", tenant_id = "common" }
}
