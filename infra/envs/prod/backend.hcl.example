# Only for running Terraform by hand. deploy.yml creates the bucket on its first run
# (scripts/ensure-state-bucket.sh) and passes these values itself.
bucket       = "aic-prod-tfstate-<account-id>-eu-north-1"
key          = "prod/terraform.tfstate"
region       = "eu-north-1"
encrypt      = true
use_lockfile = true
