{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SearchKnowledge",
      "Effect": "Allow",
      "Action": ["bedrock:Retrieve"],
      "Resource": "${knowledge_base_arn}"
    },
    {
      "Sid": "ReadKnowledgeGraph",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:BatchGetItem"],
      "Resource": ["${knowledge_table_arn}", "${knowledge_table_arn}/index/*"]
    }
  ]
}
